# NexusRAG Frontend Environment Variables
# ========================================

# API base URL — default uses Vite proxy (dev) or nginx proxy (Docker)
# For production on the AI subdomain, uncomment:
# VITE_API_URL=https://ai.itrecruitment.dpdns.org/api/v1
# Only override if backend is on a different host/port
# VITE_API_URL=/api/v1

# API key auth for protected backend routes
# Set this to one of backend API_KEYS when API_KEY_ENABLED=true
# VITE_API_KEY=your-api-key

# Optional: custom API key header name (must match backend API_KEY_HEADER)
# VITE_API_KEY_HEADER=X-API-Key
