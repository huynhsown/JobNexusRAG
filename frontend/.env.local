# Frontend runtime environment (Vite)
# Use Vite proxy/nginx by default. Override only when needed.
VITE_API_URL=/api/v1

# API key sent to backend for protected routes
# Replace with one of backend API_KEYS values
VITE_API_KEY=4fb79cd97c017594063ef8dd6e52ab772190986435ef7f659b0525d5c182ccba

# Must match backend API_KEY_HEADER (default: X-API-Key)
VITE_API_KEY_HEADER=X-API-Key
